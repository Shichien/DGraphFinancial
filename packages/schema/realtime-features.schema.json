{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RealtimeFeatures",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "src_account",
    "dst_account",
    "amount",
    "source_channel",
    "device_id",
    "ip",
    "merchant_id",
    "edge_type",
    "scenario_id",
    "fraud_script_type",
    "is_scripted_fraud",
    "src_1m_count",
    "src_5m_amount",
    "src_10m_counterparty_count",
    "device_account_count",
    "ip_account_count",
    "merchant_in_amount",
    "src_out_degree",
    "dst_in_degree",
    "seconds_since_last_src_event",
    "channel_switch_count",
    "burst_score",
    "graph_neighbor_count",
    "graph_risky_neighbor_count",
    "graph_component_size",
    "graph_community_id",
    "graph_related_nodes",
    "historical_risk_score",
    "account_age_days",
    "recent_login_challenge_count",
    "blacklist_hit_count",
    "script_score"
  ],
  "properties": {
    "event_id": { "type": "integer" },
    "timestamp": { "type": "integer" },
    "src_account": { "type": "integer" },
    "dst_account": { "type": "integer" },
    "amount": { "type": "number" },
    "source_channel": { "type": "string" },
    "device_id": { "type": "string" },
    "ip": { "type": "string" },
    "merchant_id": { "type": "string" },
    "edge_type": { "type": "integer" },
    "scenario_id": { "type": "string" },
    "fraud_script_type": { "type": "string" },
    "is_scripted_fraud": { "type": "boolean" },
    "src_1m_count": { "type": "integer" },
    "src_5m_amount": { "type": "number" },
    "src_10m_counterparty_count": { "type": "integer" },
    "device_account_count": { "type": "integer" },
    "ip_account_count": { "type": "integer" },
    "merchant_in_amount": { "type": "number" },
    "src_out_degree": { "type": "integer" },
    "dst_in_degree": { "type": "integer" },
    "seconds_since_last_src_event": { "type": "integer" },
    "channel_switch_count": { "type": "integer" },
    "burst_score": { "type": "number" },
    "graph_neighbor_count": { "type": "integer" },
    "graph_risky_neighbor_count": { "type": "integer" },
    "graph_component_size": { "type": "integer" },
    "graph_community_id": { "type": "string" },
    "graph_related_nodes": { "type": "array", "items": { "type": "integer" } },
    "historical_risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "account_age_days": { "type": "integer", "minimum": 0 },
    "recent_login_challenge_count": { "type": "integer", "minimum": 0 },
    "blacklist_hit_count": { "type": "integer", "minimum": 0 },
    "script_score": { "type": "number" }
  },
  "additionalProperties": true
}
